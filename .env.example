# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=
# Server-side only (Netlify Functions). NEVER expose in the frontend.
SUPABASE_SECRET_KEY=
# Legacy alias, still read as fallback by supabaseAdmin()
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin Panel ─────────────────────────────────────────────────────────────
# IMPORTANT: Set strong, unique credentials before deployment
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── WhatsApp / Meta Cloud API (optional) ────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Google Sheets backup (optional) ─────────────────────────────────────────
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_TOKEN=

# ─── Payment Gateway: Wompi ──────────────────────────────────────────────────
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ─── Payment Gateway: Bold ───────────────────────────────────────────────────
BOLD_API_KEY=
BOLD_SECRET=

# ─── Feature Flags ───────────────────────────────────────────────────────────
PAYMENTS_GATEWAY=disabled       # WOMPI | BOLD | disabled
REACTIVATION_ENABLED=false      # true | false (global kill switch)
